# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env
# .env dosyası git'e GÖNDERİLMEZ.

# Laravel API'nin adresi ("/api" dahil, sonda / olmadan).
# Boş bırakılırsa site otomatik olarak sahte (mock) verilerle çalışır.
VITE_API_URL=http://localhost:8000/api

# true yapılırsa API adresi verilmiş olsa bile sahte veriler kullanılır.
# Backend hazır olana kadar true bırakın.
VITE_USE_MOCK=true

# --- İsteğe bağlı: CORS'suz geliştirme ---
# Aşağıdakini açıp VITE_API_URL=/api yaparsanız, Vite /api isteklerini
# Laravel sunucusuna kendisi yönlendirir (Laravel tarafında CORS gerekmez).
# API_PROXY_TARGET=http://localhost:8000
